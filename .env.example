# Copy to server/.env for the API, and to client/.env for the SPA.
# Never commit real values. The service-role key belongs to server/.env ONLY.
#
# The API reads this file at boot and refuses to start if anything below is missing or
# malformed. Local development works without a Supabase project: put any well-formed URL
# and any 40-character string in the two SUPABASE_* slots and every route except the
# public ones will answer 401, because no token can be verified. Replace both in phase 4,
# when sign-up needs a real project.

# ---- server ----
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketlink
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
CLIENT_ORIGIN=http://localhost:5173

# ---- client ----
# VITE_ prefix exposes a variable to the browser bundle. Anon key only, ever.
# The server never reads the anon key; it has the service-role key, which is stronger.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=paste-anon-key-here
VITE_API_URL=http://localhost:4000/api
