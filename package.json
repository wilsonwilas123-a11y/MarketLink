{
  "name": "marketlink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm run test -w server && npm run test -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "db:migrate": "npm run migrate -w server",
    "db:seed": "npm run seed -w server",
    "db:test": "npm run db:test -w server",
    "openapi": "npm run openapi -w server"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2"
  }
}
