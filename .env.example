# Copy to server/.env for the API, and to client/.env for the SPA.
# Never commit real values. The service-role key belongs to server/.env ONLY.

# ---- server ----
PORT=4000
NODE_ENV=development
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
SUPABASE_ANON_KEY=paste-anon-key-here
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketlink
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/marketlink_test
CLIENT_ORIGIN=http://localhost:5173

# ---- client ----
# VITE_ prefix exposes a variable to the browser bundle. Anon key only, ever.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=paste-anon-key-here
VITE_API_URL=http://localhost:4000/api
